# GEMINI_API_KEY — required for the chatbot (Google Gemini).
# 1) Copy this file to `.env` in the same folder as `package.json`.
# 2) Create a key: https://aistudio.google.com/apikey
# 3) Paste it below (no quotes needed unless the key contains spaces).
# 4) Restart `npm run dev` after changing `.env`.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EmailJS Configuration (Required for Contact Form)
VITE_EMAILJS_SERVICE_ID="service_wpvp0x4"
VITE_EMAILJS_TEMPLATE_ID="template_7o2ivqn"
VITE_EMAILJS_PUBLIC_KEY="RJkiENEdcgZ2mu9Da"
